# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripslab?schema=public"

# --- Redis (rate limiting, lead cache, sessions) ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth (JWT / session secret) ---
AUTH_SECRET="replace-with-a-long-random-string"

# --- Payments: Razorpay ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Payments: Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- OTP / SMS (traveler verification) ---
MSG91_AUTH_KEY=""
OTP_TTL_SECONDS="300"

# --- Abuse prevention ---
MAX_LEADS_PER_24H="3"
# "true" disables the lead rate limiter (handy for local testing). Leave unset
# or "false" in production.
RATE_LIMIT_DISABLED="false"




GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
