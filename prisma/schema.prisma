generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Traveler {
  id           String     @id @default(cuid())
  name         String
  email        String
  mobile       String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  lastIp       String?
  fingerprint  String?
  blockedUntil DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  leads        Lead[]

  @@index([email])
  @@index([mobile])
  @@index([fingerprint])
}

model Lead {
  id            String     @id @default(cuid())
  reference     String     @unique
  status        LeadStatus @default(NEW)
  destination   String
  departureCity String
  travelers     Int
  budget        Int
  perHead       Int
  travelDate    DateTime
  tripType      String
  preferences   String?
  slab          SlabId
  price         Int
  leadScore     Int        @default(0)
  statusNote    String? // admin reason when flagged as fraud / hidden
  slabLabel     String? // label of the (possibly custom) slab tier at creation
  otpVerified   Boolean    @default(false)
  ipAddress     String?
  fingerprint   String?
  travelerId    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  traveler      Traveler   @relation(fields: [travelerId], references: [id])
  purchases     Purchase[]

  @@index([slab, status])
  @@index([status, createdAt])
  @@index([destination])
}

model Agency {
  id           String           @id @default(cuid())
  name         String
  ownerName    String
  email        String           @unique
  phone        String
  gstNumber    String?
  city         String?
  passwordHash String
  documentsUrl String?
  status       AgencyStatus     @default(PENDING)
  statusNote   String? // admin reason when suspended/blocked
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  purchases    Purchase[]
  documents    AgencyDocument[]
  resetTokens  AgencyResetToken[]
  packages     Package[]

  @@index([status])
  @@index([phone])
}

/// Password-reset tokens for agencies. Only the SHA-256 hash of the token is
/// stored; the raw token lives only in the emailed/returned reset link.
model AgencyResetToken {
  id        String    @id @default(cuid())
  agencyId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

/// KYC / verification files an agency uploads (GST certificate, PAN, etc).
/// Stored as base64 data URLs so no external object storage is required —
/// mirrors how home banners persist uploaded images. The heavy `dataUrl` is
/// never selected in list views; it's fetched on demand by the admin viewer.
model AgencyDocument {
  id        String   @id @default(cuid())
  agencyId  String
  label     String // e.g. "GST Certificate", "PAN Card"
  fileName  String
  mimeType  String
  size      Int      @default(0)
  dataUrl   String // data:<mime>;base64,<...>
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model Purchase {
  id        String   @id @default(cuid())
  leadId    String
  agencyId  String
  amount    Int
  invoiceNo String   @unique
  createdAt DateTime @default(now())
  payment   Payment?
  agency    Agency   @relation(fields: [agencyId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@unique([leadId, agencyId])
  @@index([agencyId, createdAt])
  @@index([leadId])
}

model Payment {
  id          String          @id @default(cuid())
  purchaseId  String          @unique
  provider    PaymentProvider
  providerRef String
  status      PaymentStatus   @default(CREATED)
  amount      Int
  currency    String          @default("INR")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  purchase    Purchase        @relation(fields: [purchaseId], references: [id])

  @@index([status])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SlabPricing {
  slab      SlabId   @id
  leadPrice Int
  // When set, overrides the code default for auto-hiding new leads in this slab.
  // null => fall back to the built-in default (premium ₹50k+ slabs).
  autoHide  Boolean?
  updatedAt DateTime @updatedAt
}

/// Admin-managed budget slab ranges (per-traveller). Replaces the fixed slab
/// set for lead pricing, auto-hide and labelling. `maxPerHead` null = no upper
/// bound. The agency marketplace still uses the built-in bands.
model SlabTier {
  id         String   @id @default(cuid())
  label      String
  minPerHead Int
  maxPerHead Int? // null = no upper bound (top tier)
  leadPrice  Int
  autoHide   Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

model OtpCode {
  mobile    String   @id
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  kind      String   @default("composed") // "composed" | "image"
  imageUrl  String? // full ready-made banner (kind = "image")
  eyebrow   String
  title     String
  accent    String
  subtitle  String?
  discount  String?
  cta       String
  href      String
  theme     String   @default("emerald")
  images    String[]
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Notification {
  id        String        @id @default(cuid())
  audience  NotifAudience
  refId     String?
  kind      NotifKind     @default(SYSTEM)
  title     String
  body      String
  slab      SlabId?
  leadRef   String?
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([audience, read, createdAt])
  @@index([audience, refId, createdAt])
}

/// Admin-managed travel destination (Goa, Bali, …). Homepage cards and the
/// /destinations/[slug] pages are driven by these rows. Seeded on first use
/// from the built-in catalogue so nothing looks empty before the admin edits.
model Destination {
  id             String              @id @default(cuid())
  slug           String              @unique
  name           String
  region         String
  /// "India" | "World" — groups the destination in the mega menu / filters.
  scope          String              @default("India")
  heroImage      String
  gallery        String[]
  description    String
  bestTime       String
  idealDuration  String
  highlights     String[]
  tags           String[]
  /// Cheapest per-head price across its approved packages (denormalised for
  /// the "Starting from" badge + budget bucketing). 0 = no packages yet.
  startingFrom   Int                 @default(0)
  status         DestinationStatus   @default(PUBLISHED)
  featured       Boolean             @default(false)
  order          Int                 @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  packages       Package[]
  faqs           DestinationFAQ[]
  reviews        DestinationReview[]

  @@index([status, featured, order])
}

/// A trip package created by an agency and attached to a destination. Public
/// projections NEVER expose `agencyId` or any agency detail — travellers only
/// see the package itself. Auto-appears under its destination once APPROVED.
model Package {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  agencyId       String
  destinationId  String
  duration       String // human label e.g. "6N/7D"
  durationDays   Int            @default(0) // numeric, for the duration filter
  price          Int // per-head, INR
  /// Snapshot of the SlabTier the agency chose (tiers are admin-editable, so we
  /// keep a label snapshot; bucketing also falls back to `price`).
  slabId         String?
  slabLabel      String?
  /// Admin-managed trip type/category chosen by the agency (soft link + label
  /// snapshot so deleting a type never breaks a package).
  typeId         String?
  typeLabel      String?
  description    String
  inclusions     String[]
  exclusions     String[]
  highlights     String[]
  /// [{ day: number, title: string, detail: string }] — optional itinerary.
  itinerary      Json?
  maxTravelers   Int            @default(0)
  featured       Boolean        @default(false)
  status         PackageStatus  @default(PENDING)
  order          Int            @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  agency         Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  destination    Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  images         PackageImage[]
  dates          PackageDate[]

  @@index([destinationId, status])
  @@index([status, featured, order])
  @@index([agencyId])
  @@index([price])
}

/// Gallery image for a package. Stored as a data URL (base64) or remote URL —
/// mirrors how banners / KYC files persist without external object storage.
model PackageImage {
  id        String   @id @default(cuid())
  packageId String
  dataUrl   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

/// A departure date offered for a package.
model PackageDate {
  id        String   @id @default(cuid())
  packageId String
  date      DateTime
  seatsLeft Int?
  createdAt DateTime @default(now())
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

/// Editable FAQ shown on a destination page (and its packages).
model DestinationFAQ {
  id            String      @id @default(cuid())
  destinationId String
  question      String
  answer        String
  order         Int         @default(0)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

/// Traveller review shown on a destination page (and its packages).
model DestinationReview {
  id            String      @id @default(cuid())
  destinationId String
  author        String
  rating        Int         @default(5)
  comment       String
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

/// Admin-managed trip type / category (Backpacking, Bike Trips, Himalayan
/// Treks, …). Drives the mega-menu category column + homepage trip tabs, and is
/// the "type" an agency tags each package with. Seeded from the built-in list.
model TripType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  subtitle  String?
  icon      String   @default("Compass") // lucide icon name
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

enum DestinationStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum PackageStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  PAUSED
}

enum SlabId {
  s0_5k
  s5_10k
  s10_20k
  s20_50k
  s50_100k
  s100k_plus
}

enum LeadStatus {
  NEW
  VERIFIED
  AVAILABLE
  SOLD
  HIDDEN
  FRAUD
}

enum AgencyStatus {
  PENDING
  APPROVED
  SUSPENDED
  BLOCKED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum NotifAudience {
  TRAVELER
  AGENCY
  ADMIN
}

enum NotifKind {
  LEAD_AVAILABLE
  LEAD_PURCHASED
  SUSPICIOUS
  AGENCY_REGISTRATION
  SYSTEM
}
