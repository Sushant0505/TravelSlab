generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Traveler {
  id           String     @id @default(cuid())
  name         String
  email        String
  mobile       String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  lastIp       String?
  fingerprint  String?
  blockedUntil DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  leads        Lead[]

  @@index([email])
  @@index([mobile])
  @@index([fingerprint])
}

model Lead {
  id            String     @id @default(cuid())
  reference     String     @unique
  status        LeadStatus @default(NEW)
  destination   String
  departureCity String
  travelers     Int
  budget        Int
  perHead       Int
  travelDate    DateTime
  tripType      String
  preferences   String?
  slab          SlabId
  price         Int
  leadScore     Int        @default(0)
  otpVerified   Boolean    @default(false)
  ipAddress     String?
  fingerprint   String?
  travelerId    String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  traveler      Traveler   @relation(fields: [travelerId], references: [id])
  purchases     Purchase[]

  @@index([slab, status])
  @@index([status, createdAt])
  @@index([destination])
}

model Agency {
  id           String       @id @default(cuid())
  name         String
  ownerName    String
  email        String       @unique
  phone        String
  gstNumber    String?
  passwordHash String
  documentsUrl String?
  status       AgencyStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  purchases    Purchase[]

  @@index([status])
}

model Purchase {
  id        String   @id @default(cuid())
  leadId    String
  agencyId  String
  amount    Int
  invoiceNo String   @unique
  createdAt DateTime @default(now())
  payment   Payment?
  agency    Agency   @relation(fields: [agencyId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@unique([leadId, agencyId])
  @@index([agencyId, createdAt])
  @@index([leadId])
}

model Payment {
  id          String          @id @default(cuid())
  purchaseId  String          @unique
  provider    PaymentProvider
  providerRef String
  status      PaymentStatus   @default(CREATED)
  amount      Int
  currency    String          @default("INR")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  purchase    Purchase        @relation(fields: [purchaseId], references: [id])

  @@index([status])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SlabPricing {
  slab      SlabId   @id
  leadPrice Int
  updatedAt DateTime @updatedAt
}

model OtpCode {
  mobile    String   @id
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  kind      String   @default("composed") // "composed" | "image"
  imageUrl  String? // full ready-made banner (kind = "image")
  eyebrow   String
  title     String
  accent    String
  subtitle  String?
  discount  String?
  cta       String
  href      String
  theme     String   @default("emerald")
  images    String[]
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Notification {
  id        String        @id @default(cuid())
  audience  NotifAudience
  refId     String?
  kind      NotifKind     @default(SYSTEM)
  title     String
  body      String
  slab      SlabId?
  leadRef   String?
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([audience, read, createdAt])
  @@index([audience, refId, createdAt])
}

enum SlabId {
  s0_5k
  s5_10k
  s10_20k
  s20_50k
  s50_100k
  s100k_plus
}

enum LeadStatus {
  NEW
  VERIFIED
  AVAILABLE
  SOLD
  HIDDEN
  FRAUD
}

enum AgencyStatus {
  PENDING
  APPROVED
  SUSPENDED
  BLOCKED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum NotifAudience {
  TRAVELER
  AGENCY
  ADMIN
}

enum NotifKind {
  LEAD_AVAILABLE
  LEAD_PURCHASED
  SUSPICIOUS
  AGENCY_REGISTRATION
  SYSTEM
}
