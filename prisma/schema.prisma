// TripSlab — data model
// Generator + datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SlabId {
  s0_5k
  s5_10k
  s10_20k
  s20_50k
  s50_100k
  s100k_plus
}

enum LeadStatus {
  NEW // just generated, not yet verified
  VERIFIED // OTP passed
  AVAILABLE // listed in marketplace
  SOLD // purchased by an agency
  HIDDEN // hidden by admin
  FRAUD // flagged as fake
}

enum AgencyStatus {
  PENDING // awaiting admin approval
  APPROVED
  SUSPENDED
  BLOCKED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Traveler (the person who submits a trip request)
// ---------------------------------------------------------------------------

model Traveler {
  id        String     @id @default(cuid())
  name      String
  email     String
  mobile    String
  status    UserStatus @default(ACTIVE)
  // Anti-abuse signals
  lastIp        String?
  fingerprint   String?
  blockedUntil  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([email])
  @@index([mobile])
  @@index([fingerprint])
}

// ---------------------------------------------------------------------------
// Lead (a trip request; the tradeable unit of the marketplace)
// ---------------------------------------------------------------------------

model Lead {
  id         String     @id @default(cuid())
  reference  String     @unique // human-friendly, e.g. TS-8F3K2Q
  status     LeadStatus @default(NEW)

  // Trip details
  destination   String
  departureCity String
  travelers     Int
  budget        Int // total, INR
  perHead       Int // budget / travelers, drives the slab
  travelDate    DateTime
  tripType      String
  preferences   String?  @db.Text

  // Marketplace metadata
  slab      SlabId
  price     Int // agency unlock price, INR (snapshot of slab price)
  leadScore Int    @default(0) // 0..100

  // Verification / abuse
  otpVerified Boolean @default(false)
  ipAddress   String?
  fingerprint String?

  travelerId String
  traveler   Traveler @relation(fields: [travelerId], references: [id])

  // Non-exclusive marketplace: the same lead can be unlocked by many agencies.
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slab, status])
  @@index([status, createdAt])
  @@index([destination])
}

// ---------------------------------------------------------------------------
// Agency (the buyer)
// ---------------------------------------------------------------------------

model Agency {
  id          String       @id @default(cuid())
  name        String
  ownerName   String
  email       String       @unique
  phone       String
  gstNumber   String?
  passwordHash String
  documentsUrl String? // KYC docs
  status      AgencyStatus @default(PENDING)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Purchase (an agency unlocks a lead)
// ---------------------------------------------------------------------------

model Purchase {
  id        String @id @default(cuid())
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id])
  agencyId  String
  agency    Agency @relation(fields: [agencyId], references: [id])

  amount    Int // INR
  invoiceNo String @unique

  payment Payment?

  createdAt DateTime @default(now())

  // A lead may be unlocked by many agencies, but each agency only once.
  @@unique([leadId, agencyId])
  @@index([agencyId, createdAt])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Payment (Razorpay / Stripe transaction backing a purchase)
// ---------------------------------------------------------------------------

model Payment {
  id            String          @id @default(cuid())
  purchaseId    String          @unique
  purchase      Purchase        @relation(fields: [purchaseId], references: [id])
  provider      PaymentProvider
  providerRef   String // razorpay_order_id / stripe_payment_intent
  status        PaymentStatus   @default(CREATED)
  amount        Int
  currency      String          @default("INR")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// SlabPricing (admin-editable override of default slab prices)
// ---------------------------------------------------------------------------

model SlabPricing {
  slab      SlabId   @id
  leadPrice Int
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Notification (traveler / agency / admin feed)
// ---------------------------------------------------------------------------

enum NotifAudience {
  TRAVELER
  AGENCY
  ADMIN
}

enum NotifKind {
  LEAD_AVAILABLE
  LEAD_PURCHASED
  SUSPICIOUS
  AGENCY_REGISTRATION
  SYSTEM
}

model Notification {
  id        String        @id @default(cuid())
  audience  NotifAudience
  refId     String? // travelerId / agencyId when targeted
  kind      NotifKind     @default(SYSTEM)
  title     String
  body      String
  slab      SlabId? // budget slab the notification relates to (lead alerts)
  leadRef   String? // human-friendly lead reference, e.g. TS-8F3K2Q
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([audience, read, createdAt])
  @@index([audience, refId, createdAt])
}
